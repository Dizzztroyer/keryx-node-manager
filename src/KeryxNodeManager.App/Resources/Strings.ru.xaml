    <sys:String x:Key="Str_Models_Refresh">Обновить</sys:String>
    <sys:String x:Key="Str_Models_FromLabel"> · от </sys:String>
    <sys:String x:Key="Str_Models_VramSuffix"> МБ VRAM</sys:String>
    <sys:String x:Key="Str_Models_UrlLabel">URL для скачивания (вставьте ссылку из README keryx-miner)</sys:String>
    <sys:String x:Key="Str_Models_Sha256Label">Ожидаемый SHA-256 (необязательно)</sys:String>
    <sys:String x:Key="Str_Models_Download">Скачать</sys:String>
    <sys:String x:Key="Str_Models_Resume">Продолжить</sys:String>
    <sys:String x:Key="Str_Models_Pause">Пауза</sys:String>
    <sys:String x:Key="Str_Models_Cancel">Отмена</sys:String>
    <sys:String x:Key="Str_Models_Delete">Удалить</sys:String>
    <sys:String x:Key="Str_Models_OpenFolder">Открыть папку</sys:String>
    <!-- One-click official-mirror download (brief follow-up, 2026-08-03) - see
         OfficialModelMirrors in Core for the verified mirror table this button installs from. -->
    <sys:String x:Key="Str_Models_DownloadOfficial">Скачать официальную модель</sys:String>
    <sys:String x:Key="Str_Models_ManualMirrorExpander">Указать свою ссылку (другое зеркало)</sys:String>

    <!-- Node page (brief §8), fourth slice of the full-extraction pass. NodeViewModel.StatusMessage
         (connectivity check results/errors) and the native OpenFileDialog title/filter set in C#
         stay hardcoded Russian, same documented limitation as the other pages. -->
    <sys:String x:Key="Str_Node_Title">Нода</sys:String>
    <sys:String x:Key="Str_Node_PathLabel">Путь к keryxd.exe</sys:String>
    <sys:String x:Key="Str_Node_Browse">Обзор...</sys:String>
    <sys:String x:Key="Str_Node_EndpointLabel">Адрес keryxd (обычно 127.0.0.1)</sys:String>
    <sys:String x:Key="Str_Node_TestnetCheckbox">Тестовая сеть (testnet)</sys:String>
    <sys:String x:Key="Str_Node_Save">Сохранить</sys:String>
    <sys:String x:Key="Str_Node_CheckEndpoint">Проверить endpoint</sys:String>
    <sys:String x:Key="Str_Node_FooterNote">Запуск/остановка ноды из этого окна — кнопками «Запустить всё»/«Остановить всё» на странице «Обзор», после того как настройки здесь сохранены.</sys:String>

    <!-- Miner page (brief §9), fifth slice of the full-extraction pass. MinerViewModel's
         StatusMessage/AddressValidationMessage/CommandPreview and native dialog titles stay
         hardcoded Russian, same documented limitation as the other pages. -->
    <sys:String x:Key="Str_Miner_Title">Майнер</sys:String>
    <sys:String x:Key="Str_Miner_AddressLabel">Адрес для майнинга</sys:String>
    <sys:String x:Key="Str_Miner_PathLabel">Путь к keryx-miner.exe</sys:String>
    <sys:String x:Key="Str_Miner_Browse">Обзор...</sys:String>
    <sys:String x:Key="Str_Miner_ModelsFolderLabel">Папка моделей</sys:String>
    <sys:String x:Key="Str_Miner_Save">Сохранить</sys:String>
    <sys:String x:Key="Str_Miner_AdvancedMode">Расширенный режим</sys:String>
    <sys:String x:Key="Str_Miner_CommandPreviewHeader">Команда запуска (предпросмотр)</sys:String>
    <sys:String x:Key="Str_Miner_GpuNote">Каждая видеокарта работает со своей моделью. Видеопамять разных GPU не объединяется.</sys:String>

    <!-- Logs page (brief §12), sixth slice of the full-extraction pass. LogsViewModel.StatusMessage
         and the native SaveFileDialog title/filter stay hardcoded Russian, same documented
         limitation as the other pages. -->
    <sys:String x:Key="Str_Logs_Title">Логи</sys:String>
    <sys:String x:Key="Str_Logs_ExportDiagnostics">Экспорт диагностики...</sys:String>
