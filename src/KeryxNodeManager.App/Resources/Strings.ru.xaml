    <sys:String x:Key="Str_Logs_ClearDisplay">Очистить экран</sys:String>
    <sys:String x:Key="Str_Logs_NodeHeader">Нода (keryxd)</sys:String>
    <sys:String x:Key="Str_Logs_MinerHeader">Майнер (keryx-miner)</sys:String>

    <!-- Profiles page, seventh slice of the full-extraction pass. ProfilesViewModel.StatusMessage
         stays hardcoded Russian, same documented limitation as the other pages. -->
