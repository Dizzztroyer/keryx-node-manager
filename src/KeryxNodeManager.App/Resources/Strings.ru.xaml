         NOT covered by this pass - only the View's own static labels are). -->
    <sys:String x:Key="Str_Dashboard_Title">Обзор</sys:String>
    <sys:String x:Key="Str_Dashboard_Node">Нода</sys:String>
    <sys:String x:Key="Str_Dashboard_Miner">Майнер</sys:String>
