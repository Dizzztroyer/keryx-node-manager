    <sys:String x:Key="Str_Dashboard_GpuDisabledSuffix"> отключена(ы)</sys:String>
    <sys:String x:Key="Str_Dashboard_StartAll">Запустить всё</sys:String>
    <sys:String x:Key="Str_Dashboard_StopAll">Остановить всё</sys:String>
