<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Localization infrastructure (brief §16), first increment. This is the "en" set's default/
        fallback twin - loaded when AppSettings.Language is "ru" (the app's original default, so a
        fresh install with no explicit language choice behaves exactly as every earlier session's
        hardcoded-Russian pages already did).

        Scope, stated honestly: only the Settings page and the MainWindow nav-footer labels are
        wired to these DynamicResource keys so far - the mechanism (LocalizationManager swapping
        this dictionary at runtime, DynamicResource re-evaluating live with no app restart) is
        proven end-to-end, but the other ~11 Views and their ViewModels still have Russian text
        hardcoded inline, same as before this increment. See PROJECT_STATUS.md for the full,
        file-by-file list of what remains.
    -->

    <sys:String x:Key="Str_Settings_Title">Настройки</sys:String>
    <sys:String x:Key="Str_Settings_Startup_Header">Запуск</sys:String>
    <sys:String x:Key="Str_Settings_StartWithWindows">Запускать Keryx Node Manager при входе в Windows</sys:String>
    <sys:String x:Key="Str_Settings_StartWithWindows_Note">Создаётся задача в Планировщике заданий Windows (без прав администратора).</sys:String>
    <sys:String x:Key="Str_Settings_CheckingAutostart">Проверка текущего статуса автозапуска...</sys:String>
    <sys:String x:Key="Str_Settings_StartMinimizedToTray">Запускать свёрнутым в трей</sys:String>
    <sys:String x:Key="Str_Settings_CloseMinimizesToTray">Кнопка закрытия окна сворачивает в трей (а не завершает работу)</sys:String>
    <sys:String x:Key="Str_Settings_NotificationsEnabled">Показывать уведомления</sys:String>
    <sys:String x:Key="Str_Settings_Logs_Header">Логи</sys:String>
    <sys:String x:Key="Str_Settings_LogRetentionDays">Хранить логи (дней)</sys:String>
    <sys:String x:Key="Str_Settings_MaxLogSizeMb">Максимальный размер файла лога (МБ)</sys:String>
    <sys:String x:Key="Str_Settings_Monitoring_Header">Мониторинг</sys:String>
    <sys:String x:Key="Str_Settings_MonitoringInterval">Интервал опроса GPU/статуса (сек)</sys:String>
    <sys:String x:Key="Str_Settings_Safety_Header">Защита от перегрева</sys:String>
    <sys:String x:Key="Str_Settings_SafetyEnabled">Автоматически останавливать майнинг при критической температуре GPU</sys:String>
    <sys:String x:Key="Str_Settings_WarningThreshold">Порог предупреждения (°C)</sys:String>
    <sys:String x:Key="Str_Settings_CriticalThreshold">Критический порог - останавливает майнинг (°C)</sys:String>
    <sys:String x:Key="Str_Settings_SafetyNote">Проверяется, пока запущен майнер (см. страницу «Обзор»).</sys:String>
    <sys:String x:Key="Str_Settings_Language_Header">Язык</sys:String>
    <sys:String x:Key="Str_Settings_Save">Сохранить</sys:String>

    <sys:String x:Key="Str_Nav_VersionLabel">Версия: </sys:String>
    <sys:String x:Key="Str_Nav_ProfileLabel">Профиль: </sys:String>

    <!-- Dashboard page (brief §5), added in the "full string extraction" pass - see
         PROJECT_STATUS.md for what's covered so far vs. what's still hardcoded (the
