    <sys:String x:Key="Str_Profiles_Delete">Удалить</sys:String>
    <sys:String x:Key="Str_Profiles_NewHeader">Новый профиль</sys:String>
    <sys:String x:Key="Str_Profiles_Create">Создать</sys:String>
