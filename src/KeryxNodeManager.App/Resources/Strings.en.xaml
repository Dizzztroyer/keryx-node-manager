    <sys:String x:Key="Str_Wizard_Step2_DefaultPrefix">Default: </sys:String>
    <sys:String x:Key="Str_Wizard_Step3_Title">Reward address</sys:String>
    <sys:String x:Key="Str_Wizard_Step3_Body">Only a public address is entered (keryx:... or keryxtest:...). The wizard never asks for or stores a seed phrase or private key.</sys:String>
    <sys:String x:Key="Str_Wizard_Step4_Title">Preview model assignment by GPU</sys:String>
    <sys:String x:Key="Str_Wizard_Step4_Body">Shows which model tier would be assigned automatically right now for each detected GPU. VRAM across different GPUs is never pooled. The assignment can be changed manually later on the "GPUs" page.</sys:String>
    <sys:String x:Key="Str_Wizard_Step5_Title">Autostart</sys:String>
    <sys:String x:Key="Str_Wizard_Step5_AutoNode">Start the node (keryxd.exe) automatically</sys:String>
