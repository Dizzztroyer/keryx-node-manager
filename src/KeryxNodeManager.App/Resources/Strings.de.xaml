    <sys:String x:Key="Str_Node_UpdateCheckButton">Nach Updates suchen</sys:String>
    <sys:String x:Key="Str_Node_UpdateInstallButton">Update installieren</sys:String>
    <sys:String x:Key="Str_Node_UpdateUnknown">unbekannt</sys:String>
    <sys:String x:Key="Str_Node_DataDirHeader">Node-Daten (data dir)</sys:String>
    <sys:String x:Key="Str_Node_DataDirDesc">keryxd verfügt über keinen offiziellen integrierten Snapshot-Download-Mechanismus - aber das Keryx-Team veröffentlicht gelegentlich ein Datenarchiv für einen schnellen Start (HTTP-Link oder .torrent). Fügen Sie unten den aktuellen Link ein - das Format wird automatisch anhand der .torrent-Erweiterung erkannt.</sys:String>
    <sys:String x:Key="Str_Node_DataDirUrlLabel">Link zu einem Archiv (.zip) oder einer .torrent-Datei</sys:String>
    <sys:String x:Key="Str_Node_DataDirDirLabel">Datenverzeichnis</sys:String>
    <sys:String x:Key="Str_Node_DataDirDownloadButton">Herunterladen und entpacken</sys:String>

    <!-- ModelsView Discord/mirrors card (0.2.6 brief §9) -->
    <sys:String x:Key="Str_Models_DiscordHeader">Aktuelle Modelle und Mirrors</sys:String>
    <sys:String x:Key="Str_Models_DiscordBody">Die neuesten Modellankündigungen, offizielle Torrent-Dateien, Hugging Face, Google Drive und andere Mirrors werden im Keryx-Discord veröffentlicht. Vor dem manuellen Herunterladen eines Modells empfiehlt es sich, den Kanal Model Setup zu prüfen. Discord ist nicht die einzige Quelle für Modelle - der automatische Download über IPFS und der Download über den direkten Link unten funktionieren weiterhin.</sys:String>
