<Window x:Class="KeryxNodeManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keryx Node Manager" Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation (brief §27) -->
        <DockPanel Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <StackPanel DockPanel.Dock="Bottom" Margin="12">
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                    <Run Text="{DynamicResource Str_Nav_VersionLabel}"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0">
                    <Run Text="{DynamicResource Str_Nav_ProfileLabel}"/><Run Text="{Binding ActiveProfileName, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Keryx Node Manager" FontWeight="Bold" FontSize="15"
                           Margin="16,0,16,16" Foreground="{StaticResource TextPrimaryBrush}"/>
                <ListBox x:Name="NavList" ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         SelectionChanged="NavList_SelectionChanged"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background"
                                                        Value="{StaticResource SurfaceAltBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background"
                                                        Value="{StaticResource SurfaceBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </DockPanel>

        <!-- Content area: MainWindow.xaml.cs swaps the visible UserControl whenever SelectedPage
             changes (see NavList_SelectionChanged). Only Dashboard/GPU are real, working pages in
             this pass; the rest resolve to a shared "not implemented yet" placeholder
             (PlaceholderView) rather than silently showing nothing - see PROJECT_STATUS.md. -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24"/>
    </Grid>
</Window>
