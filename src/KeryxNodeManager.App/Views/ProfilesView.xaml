<UserControl x:Class="KeryxNodeManager.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Wrapped in a ScrollViewer - same fix as SettingsView.xaml/AboutView.xaml, see the comment
         there for the root cause (a bare StackPanel with no ScrollViewer can leave content
         unreachable on a non-maximized window). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Str_Profiles_Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                    <Run Text="{DynamicResource Str_Profiles_ActiveLabel}"/>
                    <Run Text="{Binding ActiveProfileName, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <!-- Two-line row: name + a masked-address/GPU-count quick-glance summary
                     (PROJECT_STATUS.md "In progress" item 9) - previously this ListBox bound
                     directly to a list of plain name strings, giving no way to tell profiles
                     apart without switching to each one. SelectedValuePath/SelectedValue (not
                     SelectedItem) keeps SelectedProfileName a plain string, unchanged for the
                     Switch/Rename/Delete commands below. -->
                <ListBox ItemsSource="{Binding ProfileRows}"
                         SelectedValuePath="Name"
                         SelectedValue="{Binding SelectedProfileName, Mode=TwoWay}"
                         Background="{DynamicResource SurfaceAltBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0" MaxHeight="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Summary}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{DynamicResource Str_Profiles_MakeActive}" Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding SwitchCommand}"/>
                    <Button Content="{DynamicResource Str_Profiles_Delete}" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Profiles_NewHeader}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="220" Padding="8" Background="{DynamicResource SurfaceAltBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"/>
                    <Button Content="{DynamicResource Str_Profiles_Create}" Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding CreateCommand}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Str_Profiles_NewNote}"
                           Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Profiles_RenameHeader}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding RenameToName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="220" Padding="8" Background="{DynamicResource SurfaceAltBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"/>
                    <Button Content="{DynamicResource Str_Profiles_Rename}" Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding RenameCommand}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Str_Profiles_RenameNote}"
                           Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
    </ScrollViewer>
</UserControl>
