<UserControl x:Class="KeryxNodeManager.App.Views.MinerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource Str_Miner_Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Miner_AddressLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding Profile.MiningAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,0" Padding="8" Background="{DynamicResource SurfaceAltBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"/>
                <TextBlock Text="{Binding AddressValidationMessage}" Foreground="{DynamicResource WarningBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="{DynamicResource Str_Miner_PathLabel}" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,16,0,0"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Profile.MinerExecutablePath, Mode=TwoWay}"
                             Padding="8" Background="{DynamicResource SurfaceAltBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"/>
                    <Button Grid.Column="1" Content="{DynamicResource Str_Miner_Browse}" Margin="8,0,0,0"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding BrowseExecutableCommand}"/>
                </Grid>

                <TextBlock Text="{DynamicResource Str_Miner_ModelsFolderLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,0"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Profile.ModelsDirectory, Mode=TwoWay}"
                             Padding="8" Background="{DynamicResource SurfaceAltBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"/>
                    <Button Grid.Column="1" Content="{DynamicResource Str_Miner_Browse}" Margin="8,0,0,0"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding BrowseModelsDirectoryCommand}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="{DynamicResource Str_Miner_Save}" Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}" Margin="0,0,10,0"/>
                    <CheckBox Content="{DynamicResource Str_Miner_AdvancedMode}" IsChecked="{Binding AdvancedMode, Mode=TwoWay}"
                              VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}" Visibility="{Binding AdvancedMode,
                Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Miner_CommandPreviewHeader}" FontWeight="SemiBold"/>
                <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         Margin="0,8,0,0" Padding="8" Background="{DynamicResource SurfaceAltBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                         FontFamily="Consolas"/>
                <TextBlock Text="{DynamicResource Str_Miner_GpuNote}"
                           Margin="0,8,0,0" TextWrapping="Wrap" FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0" DataContext="{Binding MinerUpdate}">
            <StackPanel>
                <TextBlock Text="Обновление keryx-miner.exe" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="Установлена версия: "/><Run Text="{Binding InstalledVersion, Mode=OneWay, FallbackValue=неизвестно, TargetNullValue=неизвестно}"/>
                    <Run Text="   ·   Последняя версия: "/><Run Text="{Binding LatestVersion, Mode=OneWay, FallbackValue=?, TargetNullValue=?}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Проверить обновления" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding CheckForUpdateCommand}" Margin="0,0,10,0"/>
                    <Button Content="Установить обновление" Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding UpdateAvailable}"/>
                </StackPanel>
                <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay, FallbackValue=0}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
