<UserControl x:Class="KeryxNodeManager.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Wrapped in a ScrollViewer - same fix as SettingsView.xaml/ProfilesView.xaml: a bare
         StackPanel with no ScrollViewer can leave content unreachable on a non-maximized window. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock Text="Keryx Node Manager" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
            <Run Text="{DynamicResource Str_About_VersionLabel}"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
        </TextBlock>

        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="{DynamicResource Str_About_Description}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 0.2.7 fix: beginner-friendly, localized "how to start mining" step-by-step guide -
             user's own request: "от а до я по пунктам, как для маленьких тупых детей". Placed right
             after the short description, before the links/system-info cards, since this is the
             single most useful thing a brand-new user should read on this page. -->
        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_About_GuideHeader}" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="{DynamicResource Str_About_GuideIntro}" TextWrapping="Wrap"
                           FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                <TextBlock Text="{DynamicResource Str_About_GuideStep1Header}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Str_About_GuideStep1Body}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>

                <TextBlock Text="{DynamicResource Str_About_GuideStep2Header}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Str_About_GuideStep2Body}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>

                <TextBlock Text="{DynamicResource Str_About_GuideStep3Header}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Str_About_GuideStep3Body}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>

                <TextBlock Text="{DynamicResource Str_About_GuideStep4Header}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Str_About_GuideStep4Body}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>

                <TextBlock Text="{DynamicResource Str_About_GuideStep5Header}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Str_About_GuideStep5Body}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_About_LinksHeader}" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,0,0,4">
                    <Hyperlink NavigateUri="https://github.com/Keryx-Labs/keryx-node"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{DynamicResource Str_About_NodeRepoLink}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,0,0,4">
                    <Hyperlink NavigateUri="https://github.com/Keryx-Labs/keryx-miner"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{DynamicResource Str_About_MinerRepoLink}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,0,0,4">
                    <Hyperlink NavigateUri="https://keryx-labs.com"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        keryx-labs.com
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="{DynamicResource Str_About_NoRepoNote}"
                           Margin="0,8,0,0" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_About_SystemHeader}" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{DynamicResource Str_About_OsLabel}"/><Run Text="{Binding OperatingSystem, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{DynamicResource Str_About_DotNetLabel}"/><Run Text="{Binding DotNetRuntime, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{DynamicResource Str_About_Is64BitLabel}"/><Run Text="{Binding Is64Bit, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
