<UserControl x:Class="KeryxNodeManager.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Wrapped in a ScrollViewer - same fix as SettingsView.xaml/ProfilesView.xaml: a bare
         StackPanel with no ScrollViewer can leave content unreachable on a non-maximized window. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock Text="Keryx Node Manager" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16">
            <Run Text="{DynamicResource Str_About_VersionLabel}"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
        </TextBlock>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="{DynamicResource Str_About_Description}"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_About_LinksHeader}" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,0,0,4">
                    <Hyperlink NavigateUri="https://github.com/Keryx-Labs/keryx-node"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{DynamicResource Str_About_NodeRepoLink}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,0,0,4">
                    <Hyperlink NavigateUri="https://github.com/Keryx-Labs/keryx-miner"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{DynamicResource Str_About_MinerRepoLink}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,0,0,4">
                    <Hyperlink NavigateUri="https://keryx-labs.com"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        keryx-labs.com
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="{DynamicResource Str_About_NoRepoNote}"
                           Margin="0,8,0,0" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_About_SystemHeader}" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{DynamicResource Str_About_OsLabel}"/><Run Text="{Binding OperatingSystem, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{DynamicResource Str_About_DotNetLabel}"/><Run Text="{Binding DotNetRuntime, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{DynamicResource Str_About_Is64BitLabel}"/><Run Text="{Binding Is64Bit, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
