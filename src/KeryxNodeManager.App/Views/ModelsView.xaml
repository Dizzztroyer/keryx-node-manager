<UserControl x:Class="KeryxNodeManager.App.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KeryxNodeManager.App.Converters"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Str_Models_Title}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="{DynamicResource Str_Models_Refresh}" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}" Margin="16,0,0,0"/>
            </StackPanel>
            <!-- Aggregate disk-usage summary (PROJECT_STATUS.md "In progress" item 6) - collapses
                 entirely (empty string, no reserved blank line) when no models directory is set or
                 nothing is installed yet, rather than showing a misleading "0 models" line. -->
            <TextBlock Text="{Binding TotalDiskUsageText}" Margin="0,6,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding TotalDiskUsageText, Converter={StaticResource StringToVis}}"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding Spec.Name, Mode=OneWay}"/>
                                <Run Text=" · "/><Run Text="{Binding Spec.Quantization, Mode=OneWay}"/>
                                <Run Text="{DynamicResource Str_Models_FromLabel}"/><Run Text="{Binding Spec.MinVramMb, Mode=OneWay}"/>
                                <Run Text="{DynamicResource Str_Models_VramSuffix}"/>
                            </TextBlock>

                            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0" Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding ProgressIsIndeterminate}"/>

                            <!-- Primary, one-click path: install straight from the verified
                                 official mirror (KeryxNodeManager.Core.ModelsManagement.
                                 OfficialModelMirrors) - no URL to find or paste. This is the
                                 button most users should ever need to touch on this page. -->
                            <Button Content="{DynamicResource Str_Models_DownloadOfficial}" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding DownloadOfficialCommand}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                <Button Content="{DynamicResource Str_Models_Delete}" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Str_Models_OpenFolder}" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenFolderCommand}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                <Button Content="{DynamicResource Str_Models_Pause}" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding PauseCommand}" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Str_Models_Cancel}" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CancelDownloadCommand}"/>
                            </StackPanel>

                            <!-- Advanced/override path, collapsed by default - a different or
                                 newer mirror than the one baked into this build (brief follow-up
                                 2026-08-03: manual "specify a path/URL" fields should be the
                                 exception, not the default, for a mainstream user). -->
                            <Expander Header="{DynamicResource Str_Models_ManualMirrorExpander}" Margin="0,12,0,0"
                                      Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource Str_Models_UrlLabel}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding SourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,0" Padding="8" Background="{StaticResource SurfaceAltBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"/>

                                    <TextBlock Text="{DynamicResource Str_Models_Sha256Label}"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                    <TextBox Text="{Binding ExpectedSha256, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,0" Padding="8" Background="{StaticResource SurfaceAltBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{DynamicResource Str_Models_Download}" Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding DownloadCommand}" Margin="0,0,8,0"
                                                Visibility="{Binding ShowDownloadButton, Converter={StaticResource BoolToVis}}"/>
                                        <!-- Distinct label for resuming a paused download vs. starting fresh
                                             (PROJECT_STATUS.md "In progress" item 6) - same DownloadCommand,
                                             ModelDownloader/ModelCardViewModel already resume from the
                                             partial file on disk when one exists, only the label was
                                             previously always "Скачать" regardless of paused state. -->
                                        <Button Content="{DynamicResource Str_Models_Resume}" Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding DownloadCommand}"
                                                Visibility="{Binding ShowResumeButton, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
