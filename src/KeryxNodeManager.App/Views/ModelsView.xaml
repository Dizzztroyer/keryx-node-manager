<UserControl x:Class="KeryxNodeManager.App.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KeryxNodeManager.App.Converters"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Str_Models_Title}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="{DynamicResource Str_Models_Refresh}" Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}" Margin="16,0,0,0"/>
            </StackPanel>
            <!-- Aggregate disk-usage summary (PROJECT_STATUS.md "In progress" item 6) - collapses
                 entirely (empty string, no reserved blank line) when no models directory is set or
                 nothing is installed yet, rather than showing a misleading "0 models" line. -->
            <TextBlock Text="{Binding TotalDiskUsageText}" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding TotalDiskUsageText, Converter={StaticResource StringToVis}}"/>

            <!-- Discord/mirrors info card (0.2.6 brief §9) - placed above the per-tier model
                 cards, but deliberately not blocking or replacing them: existing auto-download
                 (IPFS on first miner launch) and the manual URL/official-mirror buttons below are
                 untouched. This card just points at where the Keryx team posts fresher/alternative
                 mirrors than whatever is baked into this build. -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Models_DiscordHeader}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Str_Models_DiscordBody}" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="{DynamicResource Str_Models_DiscordButton}" Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding OpenDiscordCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding DiscordLinkStatus}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorBrush}"
                               Visibility="{Binding DiscordLinkStatus, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Tier reference table (2026-08-04, user request): which miner flag/model/VRAM goes
                 with which tier, and roughly how much of the block reward that tier keeps. Model
                 name/quant/VRAM columns are KeryxNodeManager.Core.Models.ModelTierCatalog's own
                 verified numbers (read directly from keryx-miner's src/models.rs - see that file's
                 doc comment), not re-typed by hand, so this table can never silently drift out of
                 sync with what the app actually downloads/launches. "Weights" and "Доля награды"
                 are additional reference numbers confirmed against keryx-node's
                 consensus/core/src/config/params.rs (TIER_REWARD_BPS_H2 = [6800,7600,8400,9200,
                 10000] - exactly 68/76/84/92/100%, indexed by tier position 0-4) and the weight-size
                 comments next to each ModelSpec in keryx-miner's models.rs - both fetched and
                 verified directly against the real source on 2026-08-04, not guessed. The
                 footnote spells out the one caveat that table alone doesn't: this tier share is
                 multiplied by a SEPARATE holder-ratio bonus (40-100%, RATIO_REWARD_BPS) based on
                 how much of your own production you hold vs. sell - so "68%" is not the whole
                 story on its own. -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Models_TierTable_Header}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="30"/>
                            <ColumnDefinition Width="Auto" MinWidth="90"/>
                            <ColumnDefinition Width="*" MinWidth="230"/>
                            <ColumnDefinition Width="Auto" MinWidth="70"/>
                            <ColumnDefinition Width="Auto" MinWidth="70"/>
                            <ColumnDefinition Width="Auto" MinWidth="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header row -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Models_TierTable_ColTier}" FontWeight="SemiBold" Margin="0,0,10,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Str_Models_TierTable_ColFlag}" FontWeight="SemiBold" Margin="0,0,10,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Str_Models_TierTable_ColModel}" FontWeight="SemiBold" Margin="0,0,10,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Str_Models_TierTable_ColMinVram}" FontWeight="SemiBold" Margin="0,0,10,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{DynamicResource Str_Models_TierTable_ColWeights}" FontWeight="SemiBold" Margin="0,0,10,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="{DynamicResource Str_Models_TierTable_ColRewardShare}" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <!-- Tier 0 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="0" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="--very-light" FontFamily="Consolas" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Qwen3-8B-abliterated (Q4_K_S)" Margin="0,0,10,4" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="6 GB" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="~4.6 GB" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="5" Text="68%" Margin="0,0,0,4"/>

                        <!-- Tier 1 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="1" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="--light" FontFamily="Consolas" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Mistral-7B-v0.3-abliterated (Q6_K)" Margin="0,0,10,4" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="8 GB" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="~5.9 GB" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="5" Text="76%" Margin="0,0,0,4"/>

                        <!-- Tier 2 (default - no flag) -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="2" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Str_Models_TierTable_DefaultFlag}" FontFamily="Consolas" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="GLM-4-9B-0414-abliterated (Q6_K)" Margin="0,0,10,4" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="12 GB" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="4" Text="~8.3 GB" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="5" Text="84%" Margin="0,0,0,4"/>

                        <!-- Tier 3 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="3" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="--high" FontFamily="Consolas" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Qwen3.6-27B-abliterated-v2 (Q4_K_M)" Margin="0,0,10,4" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="24 GB" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="~16.5 GB" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="5" Text="92%" Margin="0,0,0,4"/>

                        <!-- Tier 4 -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="4" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="--very-high" FontFamily="Consolas" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Kimi-Linear-48B-A3B-Instruct-abliterated (Q4_K_M)" Margin="0,0,10,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="30 GB" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="4" Text="~29.7 GB" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="5" Text="100%" Margin="0,0,0,0"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_Models_TierTable_Footnote}" Margin="0,14,0,0" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 0.2.7 fix: the ItemsControl itself has no scrolling behavior of its own - it only lays
             out its items and reports its full desired height to the parent DockPanel, which simply
             clips it. Wrapping it in a ScrollViewer restores mouse-wheel scrolling (and a visible
             thumb the user can drag) once the model list is taller than the window. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding Spec.Name, Mode=OneWay}"/>
                                <Run Text=" · "/><Run Text="{Binding Spec.Quantization, Mode=OneWay}"/>
                                <Run Text="{DynamicResource Str_Models_FromLabel}"/><Run Text="{Binding Spec.MinVramMb, Mode=OneWay}"/>
                                <Run Text="{DynamicResource Str_Models_VramSuffix}"/>
                            </TextBlock>

                            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <Grid Margin="0,8,0,0">
                                <ProgressBar Height="6" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             IsIndeterminate="{Binding ProgressIsIndeterminate}"/>
                                <TextBlock Text="{Binding ProgressPercentText}" FontSize="10" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                            <!-- Primary, one-click path: install straight from the verified
                                 official mirror (KeryxNodeManager.Core.ModelsManagement.
                                 OfficialModelMirrors) - no URL to find or paste. This is the
                                 button most users should ever need to touch on this page. -->
                            <Button Content="{DynamicResource Str_Models_DownloadOfficial}" Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding DownloadOfficialCommand}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                <Button Content="{DynamicResource Str_Models_Delete}" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Str_Models_OpenFolder}" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding OpenFolderCommand}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                <Button Content="{DynamicResource Str_Models_Pause}" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding PauseCommand}" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Str_Models_Cancel}" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding CancelDownloadCommand}"/>
                            </StackPanel>

                            <!-- Advanced/override path, collapsed by default - a different or
                                 newer mirror than the one baked into this build (brief follow-up
                                 2026-08-03: manual "specify a path/URL" fields should be the
                                 exception, not the default, for a mainstream user). -->
                            <Expander Header="{DynamicResource Str_Models_ManualMirrorExpander}" Margin="0,12,0,0"
                                      Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource Str_Models_UrlLabel}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding SourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,0" Padding="8" Background="{DynamicResource SurfaceAltBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"/>

                                    <TextBlock Text="{DynamicResource Str_Models_Sha256Label}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                    <TextBox Text="{Binding ExpectedSha256, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,0" Padding="8" Background="{DynamicResource SurfaceAltBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{DynamicResource Str_Models_Download}" Style="{DynamicResource PrimaryButtonStyle}"
                                                Command="{Binding DownloadCommand}" Margin="0,0,8,0"
                                                Visibility="{Binding ShowDownloadButton, Converter={StaticResource BoolToVis}}"/>
                                        <!-- Distinct label for resuming a paused download vs. starting fresh
                                             (PROJECT_STATUS.md "In progress" item 6) - same DownloadCommand,
                                             ModelDownloader/ModelCardViewModel already resume from the
                                             partial file on disk when one exists, only the label was
                                             previously always "Скачать" regardless of paused state. -->
                                        <Button Content="{DynamicResource Str_Models_Resume}" Style="{DynamicResource PrimaryButtonStyle}"
                                                Command="{Binding DownloadCommand}"
                                                Visibility="{Binding ShowResumeButton, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
