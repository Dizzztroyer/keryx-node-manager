<UserControl x:Class="KeryxNodeManager.App.Views.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KeryxNodeManager.App.Converters"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Str_Gpu_Title}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="{DynamicResource Str_Gpu_Refresh}" Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- Empty/null LastError simply renders as an empty line - no converter needed. -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding LastError}" Foreground="{DynamicResource ErrorBrush}"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- Tier reference table (moved here 2026-08-04 from ModelsView.xaml, per user follow-up:
             fits better next to this page's per-GPU mode picker/tier assignment than on Models).
             Which miner flag/model/VRAM goes with which tier, and roughly how much of the block
             reward that tier keeps. Model name/quant/VRAM columns are
             KeryxNodeManager.Core.Models.ModelTierCatalog's own verified numbers (read directly
             from keryx-miner's src/models.rs - see that file's doc comment), not re-typed by hand,
             so this table can never silently drift out of sync with what the app actually
             downloads/launches. "Weights" and "Доля награды" are additional reference numbers
             confirmed against keryx-node's consensus/core/src/config/params.rs
             (TIER_REWARD_BPS_H2 = [6800,7600,8400,9200,10000] - exactly 68/76/84/92/100%, indexed
             by tier position 0-4) and the weight-size comments next to each ModelSpec in
             keryx-miner's models.rs - both fetched and verified directly against the real source on
             2026-08-04, not guessed. The footnote spells out the one caveat the table alone
             doesn't: this tier share is multiplied by a SEPARATE holder-ratio bonus (40-100%,
             RATIO_REWARD_BPS) based on how much of your own production you hold vs. sell - so
             "68%" is not the whole story on its own. -->
        <Border DockPanel.Dock="Top" Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Models_TierTable_Header}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="30"/>
                        <ColumnDefinition Width="Auto" MinWidth="90"/>
                        <ColumnDefinition Width="*" MinWidth="230"/>
                        <ColumnDefinition Width="Auto" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" MinWidth="70"/>
                        <ColumnDefinition Width="Auto" MinWidth="70"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Models_TierTable_ColTier}" FontWeight="SemiBold" Margin="0,0,10,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Str_Models_TierTable_ColFlag}" FontWeight="SemiBold" Margin="0,0,10,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Str_Models_TierTable_ColModel}" FontWeight="SemiBold" Margin="0,0,10,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Str_Models_TierTable_ColMinVram}" FontWeight="SemiBold" Margin="0,0,10,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{DynamicResource Str_Models_TierTable_ColWeights}" FontWeight="SemiBold" Margin="0,0,10,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="5" Text="{DynamicResource Str_Models_TierTable_ColRewardShare}" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- Tier 0 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="0" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="--very-light" FontFamily="Consolas" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Qwen3-8B-abliterated (Q4_K_S)" Margin="0,0,10,4" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="6 GB" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="~4.6 GB" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="5" Text="68%" Margin="0,0,0,4"/>

                    <!-- Tier 1 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="1" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="--light" FontFamily="Consolas" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Mistral-7B-v0.3-abliterated (Q6_K)" Margin="0,0,10,4" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="8 GB" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="~5.9 GB" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="5" Text="76%" Margin="0,0,0,4"/>

                    <!-- Tier 2 (default - no flag) -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="2" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Str_Models_TierTable_DefaultFlag}" FontFamily="Consolas" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="GLM-4-9B-0414-abliterated (Q6_K)" Margin="0,0,10,4" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="12 GB" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="4" Text="~8.3 GB" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="5" Text="84%" Margin="0,0,0,4"/>

                    <!-- Tier 3 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="3" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="--high" FontFamily="Consolas" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Qwen3.6-27B-abliterated-v2 (Q4_K_M)" Margin="0,0,10,4" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="24 GB" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="4" Text="~16.5 GB" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="5" Text="92%" Margin="0,0,0,4"/>

                    <!-- Tier 4 -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="4" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="--very-high" FontFamily="Consolas" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Kimi-Linear-48B-A3B-Instruct-abliterated (Q4_K_M)" Margin="0,0,10,0" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="5" Grid.Column="3" Text="30 GB" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="5" Grid.Column="4" Text="~29.7 GB" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="5" Grid.Column="5" Text="100%" Margin="0,0,0,0"/>
                </Grid>

                <TextBlock Text="{DynamicResource Str_Models_TierTable_Footnote}" Margin="0,14,0,0" TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 0.2.7 fix (same root cause as ModelsView.xaml's own comment on this): an ItemsControl
             alone has no scrolling behavior, it only reports full desired height to the DockPanel,
             which clips it. Needed even more here now that the tier table above eats a chunk of
             vertical space docked at the top. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <ItemsControl ItemsSource="{Binding Gpus}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Device.Name}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{DynamicResource Str_Gpu_CudaLabel}"/><Run Text="{Binding Device.CudaIndex, Mode=OneWay}"/>
                                <Run Text=" · "/><Run Text="{Binding Device.TotalVramMb, Mode=OneWay}"/>
                                <Run Text="{DynamicResource Str_Gpu_VramUnit}"/><Run Text="{Binding Device.TemperatureC, Mode=OneWay}"/>
                                <Run Text="{DynamicResource Str_Gpu_TempUnit}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Device.Uuid}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource Str_Gpu_ModeLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="220"
                                          ItemsSource="{Binding DataContext.ModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValuePath="Value" DisplayMemberPath="Label"
                                          SelectedValue="{Binding Mode, Mode=TwoWay}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding AssignmentSummary}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <!-- Overclock/fan section (tasks #108-111). Hidden entirely (via
                                 Visibility BooleanToVisibility on IsSupported/IsLoaded) until a real
                                 NVAPI query confirms this card actually exposes a clock-boost table
                                 and/or cooler - see GpuOverclockSectionViewModel's own doc comment
                                 for why "not supported" is treated as an expected outcome, not an
                                 error banner. -->
                            <!-- 0.2.7 brief: overclock UI hidden regardless of Overclock.IsSupported, per
                                 GpuOverclockSectionViewModel.UiFeatureEnabled (currently false) - no real
                                 hardware Apply/write has been verified yet. Hardcoded Visibility="Collapsed"
                                 rather than a binding, since the flag is a compile-time constant; flip
                                 UiFeatureEnabled back to true and restore
                                 Visibility="{Binding Overclock.IsSupported, Converter={StaticResource BoolToVis}}"
                                 here once that verification happens. -->
                            <Border Margin="0,12,0,0" BorderThickness="1,0,0,0" Padding="12,0,0,0"
                                    BorderBrush="{DynamicResource TextSecondaryBrush}"
                                    Visibility="Collapsed">
                                <StackPanel DataContext="{Binding Overclock}">
                                    <TextBlock Text="{DynamicResource Str_Gpu_OverclockHeader}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{DynamicResource Str_Gpu_OverclockCoreLabel}"/>
                                        <Slider Grid.Row="0" Grid.Column="1" Margin="8,0"
                                                Minimum="{Binding MinCoreOffsetMhz}" Maximum="{Binding MaxCoreOffsetMhz}"
                                                Value="{Binding CoreOffsetMhz, Mode=TwoWay}" TickFrequency="10"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                                                   Text="{Binding CoreOffsetMhz}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{DynamicResource Str_Gpu_OverclockMemoryLabel}"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Margin="8,0"
                                                Minimum="{Binding MinMemoryOffsetMhz}" Maximum="{Binding MaxMemoryOffsetMhz}"
                                                Value="{Binding MemoryOffsetMhz, Mode=TwoWay}" TickFrequency="10"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                                                   Text="{Binding MemoryOffsetMhz}"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                Visibility="{Binding SupportsFanControl, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="{DynamicResource Str_Gpu_OverclockManualFan}" IsChecked="{Binding FanIsManual, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                        <Slider Width="160" Margin="8,0" VerticalAlignment="Center"
                                                Minimum="{Binding MinFanPercent}" Maximum="{Binding MaxFanPercent}"
                                                Value="{Binding FanPercent, Mode=TwoWay}"
                                                IsEnabled="{Binding FanIsManual}"/>
                                        <TextBlock Text="{Binding FanPercent}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <TextBlock Text="%" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{DynamicResource Str_Gpu_OverclockApply}" Style="{DynamicResource SecondaryButtonStyle}"
                                                Command="{Binding ApplyCommand}"/>
                                        <Button Content="{DynamicResource Str_Gpu_OverclockReset}" Style="{DynamicResource SecondaryButtonStyle}"
                                                Command="{Binding ResetCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource ErrorBrush}"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Sibling to the section above, not nested inside it - a real card
                                 caught during live verification (an NVIDIA CMP 90HX mining-only
                                 card, no display output) sets IsSupported=false with a real
                                 GpuOverclockException message, and the ORIGINAL version of this
                                 file nested this same LastError TextBlock inside the
                                 IsSupported-gated Border above, so the user saw nothing at all -
                                 no controls AND no explanation. This sibling, gated on the inverse,
                                 is what actually surfaces that explanation now. -->
                            <!-- Also hidden per the 0.2.7 feature flag above - this used to surface the
                                 raw NVAPI exception message (e.g. "NVAPI reports 1 GPU(s), but device
                                 index 1 was expected...") directly in the main UI, which the 0.2.6
                                 visual review correctly flagged as a real, user-facing raw-error leak.
                                 The technical detail is still available via Overclock.LastError for
                                 logging - it's just not rendered here while the feature is off. -->
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="Collapsed">
                                <Run Text="{DynamicResource Str_Gpu_OverclockUnavailablePrefix}"/>
                                <Run Text="{Binding Overclock.LastError, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
