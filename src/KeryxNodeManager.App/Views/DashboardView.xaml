<UserControl x:Class="KeryxNodeManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KeryxNodeManager.App.Converters"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
        <conv:CountToVisibilityConverter x:Key="CountToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{DynamicResource Str_Dashboard_Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- 0.2.7 fix: keryx-miner's own "CUDA runtime lib missing/failed to load" loop (real user
             report + confirmed present in their diagnostics export from before this app's own 0.2.7
             changes - a pre-existing environment issue, not a regression here) used to be visible
             only by digging into the Logs page. A plain user has no reason to know to look there,
             so this banner surfaces it right on the Dashboard with a direct link to the actual fix -
             installing the NVIDIA CUDA 12.6 toolkit (a system installer this app deliberately does
             not try to silently drive itself). -->
        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16" BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1" Visibility="{Binding ShowCudaRuntimeWarning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Dashboard_CudaWarningTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource ErrorBrush}"/>
                <TextBlock Text="{DynamicResource Str_Dashboard_CudaWarningBody}" TextWrapping="Wrap"
                           Margin="0,6,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="{DynamicResource Str_Dashboard_CudaWarningButton}" Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding OpenCudaDownloadPageCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- 0.2.7 fix: real root cause found 2026-08-04 - keryx-miner's own GPU mining backend
             loads from a plugin DLL sitting next to the executable (same architecture as its
             kaspa-miner ancestor). If that file is missing, the miner starts, verifies CUDA
             inference fine, then reports zero plugins/workers and exits - an installation problem
             this app cannot silently repair, since the correct companion file must come from
             wherever the user obtained this specific keryx-miner build. -->
        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16" BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1" Visibility="{Binding ShowMissingPluginWarning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Dashboard_PluginWarningTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource ErrorBrush}"/>
                <TextBlock Text="{DynamicResource Str_Dashboard_PluginWarningBody}" TextWrapping="Wrap"
                           Margin="0,6,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="{DynamicResource Str_Dashboard_PluginWarningButton}" Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding OpenMinerDiscordCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <UniformGrid Columns="3" Rows="1">
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Dashboard_Node}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding NodeStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Dashboard_Miner}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MinerStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Dashboard_Gpu}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold">
                        <Run Text="{Binding ActiveGpuCount, Mode=OneWay}"/>
                        <Run Text="{DynamicResource Str_Dashboard_GpuActiveSuffix}"/>
                        <Run Text="{Binding DisabledGpuCount, Mode=OneWay}"/>
                        <Run Text="{DynamicResource Str_Dashboard_GpuDisabledSuffix}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="{DynamicResource Str_Dashboard_StartAll}" Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding StartAllCommand}" Margin="0,0,10,0"/>
            <Button Content="{DynamicResource Str_Dashboard_StopAll}" Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding StopAllCommand}" Margin="0,0,10,0"/>
            <Button Content="{DynamicResource Str_Dashboard_Refresh}" Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <TextBlock Text="{Binding LastActionMessage}" Margin="0,16,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- "Known issues" nudge (PROJECT_STATUS.md): missing NodeExecutablePath/MiningAddress
             used to be an inert message with no way to act on it - this button jumps straight to
             whichever page (Node/Miner) actually needs attention. Only visible when
             MissingConfigTarget is set, i.e. right after a failed Start All for that specific
             reason. -->
        <Button Content="{DynamicResource Str_Dashboard_GoToSettings}" Style="{DynamicResource SecondaryButtonStyle}"
                Command="{Binding GoToMissingConfigCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                Visibility="{Binding MissingConfigTarget, Converter={StaticResource StringToVis}}"/>

        <!-- Wallet card: balance + recent unspent outputs for the profile's own public mining
             address (MiningAddress), read via keryxd's getBalanceByAddress/getUtxosByAddresses RPC
             calls. Public-address-only by construction - this app has no private key/seed anywhere
             in it, so there is nothing secret here to protect or leak; see WalletRpcService's doc
             comment. "Недавние поступления" is deliberately labeled as unspent outputs, not a full
             transaction history - keryxd's RPC surface has no address-history call. -->
        <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_Dashboard_Wallet_Title}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding WalletBalanceText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="{DynamicResource Str_Dashboard_Wallet_PublicOnlyNote}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{DynamicResource Str_Dashboard_Refresh}"
                            Style="{DynamicResource SecondaryButtonStyle}" VerticalAlignment="Top"
                            Command="{Binding RefreshWalletCommand}"/>
                </Grid>

                <TextBlock Text="{Binding WalletStatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding WalletStatusMessage, Converter={StaticResource StringToVis}}"/>

                <TextBlock Text="{DynamicResource Str_Dashboard_Wallet_RecentEntriesHeader}" FontWeight="SemiBold"
                           Margin="0,14,0,6"
                           Visibility="{Binding WalletRecentEntries.Count, Converter={StaticResource CountToVis}}"/>
                <ItemsControl ItemsSource="{Binding WalletRecentEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TransactionIdText}" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" Margin="12,0,12,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
